DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id-here
GUILD_IDS=
PREFIX=!
STEAM_API_KEY=

# Enshrouded server monitor (leave ENS_HOST blank to disable)
ENS_HOST=
ENS_QUERY_PORT=15637
ENS_CHANNEL_ID=
ENS_POLL_INTERVAL_SECONDS=60
ENS_OFFLINE_THRESHOLD=3
# Discord user IDs allowed to run /enshrouded restart (comma-separated)
ENS_RESTART_USER_IDS=

# Pterodactyl client API (Pine Hosting panel) — needed for /enshrouded restart
PTERO_PANEL_URL=https://panel.pinehosting.com
PTERO_API_KEY=
PTERO_SERVER_ID=

# Production deployment
DROPLET_IP=
DROPLET_USER=myUser
APP_DIR=/path/to/app                                                                                                                        
PM2_PROCESS_NAME=process_name